<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- IMAGE MODE -->
    <FrameLayout
        android:id="@+id/imageMode"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <com.github.chrisbanes.photoview.PhotoView
            android:id="@+id/photoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:scaleType="centerInside"
            tools:src="@drawable/cervexa_logo"/>

    </FrameLayout>

    <!-- VIDEO MODE -->
    <FrameLayout
        android:id="@+id/videoMode"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- TextureView replaces VideoView so we can getBitmap() for AI analysis -->
        <TextureView
            android:id="@+id/tvVideoTexture"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- AI Overlay: transparent ImageView drawn on top of video -->
        <ImageView
            android:id="@+id/ivAiOverlayVideo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <!-- Video play/pause indicator -->
        <ImageView
            android:id="@+id/ivPlayPause"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:src="@android:drawable/ic_media_play"
            android:alpha="0.7"
            android:visibility="gone" />

        <!-- Seekbar area at bottom -->
        <SeekBar
            android:id="@+id/sbVideoSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="4dp"
            android:layout_marginHorizontal="8dp" />

    </FrameLayout>

    <!-- AI Analysis Button (shared for both Image & Video) -->
    <LinearLayout
        android:id="@+id/btnAnalisisAi"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:background="@drawable/bg_ai_toggle_off"
        android:clickable="true"
        android:elevation="6dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="AI Icon"
            android:src="@drawable/ic_ai_toggle"
            app:tint="#888888" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Analisis AI"
            android:textColor="#888888"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Remove Overlay Button (hidden by default) -->
    <LinearLayout
        android:id="@+id/btnHapusOverlay"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:background="@drawable/bg_ai_toggle_on"
        android:clickable="true"
        android:elevation="6dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="AI Icon"
            android:src="@drawable/ic_ai_toggle"
            app:tint="#00C853" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hapus Overlay"
            android:textColor="#00C853"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- AI Loading Indicator -->
    <ProgressBar
        android:id="@+id/pbAiLoading"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center"
        android:elevation="8dp"
        android:visibility="gone" />

</FrameLayout>