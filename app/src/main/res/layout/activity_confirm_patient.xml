<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorWhite"
    android:padding="24dp">

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Konfirmasi Pasien"
        android:textSize="20sp"
        android:fontFamily="@font/manrope_medium"
        android:textColor="@color/colorBlack"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Silakan pilih jenis pasien"
        android:textSize="14sp"
        android:fontFamily="@font/manrope_medium"
        android:textColor="#666666"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- PASIEN BARU -->
    <Button
        android:id="@+id/btnNewPatient"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="40dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/bg_primary_button"
        android:text="PASIEN BARU"
        android:textAllCaps="true"
        android:textColor="@color/colorWhite"
        android:fontFamily="@font/manrope_medium"
        android:textSize="16sp"
        android:focusable="true"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
<!--        android:focusableInTouchMode="true"-->

    <!-- PASIEN LAMA -->
    <Button
        android:id="@+id/btnExistingPatient"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/bg_primary_button"
        android:text="PASIEN LAMA"
        android:textAllCaps="true"
        android:textColor="@color/colorWhite"
        android:fontFamily="@font/manrope_medium"
        android:textSize="16sp"
        android:focusable="true"
        app:layout_constraintTop_toBottomOf="@id/btnNewPatient"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
<!--        android:focusableInTouchMode="true"-->

</androidx.constraintlayout.widget.ConstraintLayout>
