<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="BlueDatePickerDialog" parent="Theme.AppCompat.Light.Dialog">
        <item name="colorAccent">#1E63E4</item>
        <item name="android:headerBackground">#1E63E4</item>

        <item name="android:buttonBarPositiveButtonStyle">@style/BlueDialogButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/BlueDialogButton</item>
    </style>

    <style name="BlueDialogButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">#1E63E4</item>
        <item name="android:background">@null</item> <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Tema fullscreen: sembunyikan status bar sejak sebelum Activity dibuat -->
    <style name="Theme.Fullscreen" parent="AppTheme.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>