<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/csVideoImage"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:background="@color/colorWhite"
    tools:context="com.idn.kmed.cervexa.live.VideoFragmentTv">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorWhite"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menu="@menu/menu_video_fragment"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Cervexa Colposcope" />

    <FrameLayout
        android:id="@+id/videoContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/black"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topAppBar">

        <TextureView
            android:id="@+id/textureView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Debug Panel for Color Tuning -->
        <ScrollView
            android:id="@+id/svDebugPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#A8000000"
            android:visibility="gone">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white" android:text="Contrast (0.0 - 2.0)" />
                <SeekBar android:id="@+id/sbContrast" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="200" android:progress="106" />
                <TextView android:id="@+id/tvContrastVal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white" android:text="1.06" />
                
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white" android:text="Brightness (-100 to 100)" android:layout_marginTop="8dp" />
                <SeekBar android:id="@+id/sbBrightness" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="200" android:progress="133" />
                <TextView android:id="@+id/tvBrightnessVal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white" android:text="33" />
                
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white" android:text="Saturation (0.0 - 2.0)" android:layout_marginTop="8dp" />
                <SeekBar android:id="@+id/sbSaturation" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="200" android:progress="106" />
                <TextView android:id="@+id/tvSaturationVal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white" android:text="1.06" />
                
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white" android:text="Red (0.0 - 2.0)" android:layout_marginTop="8dp" />
                <SeekBar android:id="@+id/sbRed" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="200" android:progress="87" />
                <TextView android:id="@+id/tvRedVal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white" android:text="0.87" />
                
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white" android:text="Green (0.0 - 2.0)" android:layout_marginTop="8dp" />
                <SeekBar android:id="@+id/sbGreen" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="200" android:progress="107" />
                <TextView android:id="@+id/tvGreenVal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white" android:text="1.07" />
                
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white" android:text="Blue (0.0 - 2.0)" android:layout_marginTop="8dp" />
                <SeekBar android:id="@+id/sbBlue" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="200" android:progress="95" />
                <TextView android:id="@+id/tvBlueVal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white" android:text="0.95" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white" android:text="Hue (-180 to 180)" android:layout_marginTop="8dp" />
                <SeekBar android:id="@+id/sbHue" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="360" android:progress="180" />
                <TextView android:id="@+id/tvHueVal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white" android:text="0" />

                <Button android:id="@+id/btnHideDebug" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hide Panel" android:layout_gravity="center" android:layout_marginTop="16dp"/>
                
            </LinearLayout>
        </ScrollView>
        
        <!-- Toggle Debug Panel -->
        <ImageButton
            android:id="@+id/btnToggleDebug"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_margin="16dp"
            android:background="@drawable/bg_overlay_black"
            android:src="@drawable/ic_menu_kebab"
            android:tint="@android:color/white"
            android:visibility="gone"
            android:contentDescription="Toggle Color Tuning" />

        <TextView
            android:id="@+id/tvOverlayInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="16dp"
            android:background="#FF000000"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="Nama RS / NRM"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:visibility="visible" />

        <TextView
            android:id="@+id/tvOverlayClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:background="@drawable/bg_overlay_black"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingVertical="4dp"
            android:text="0000-00-00 00:00:00"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:visibility="visible" />

    </FrameLayout>

    <View
        android:id="@+id/vShutterImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/black"
        android:elevation="2dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/videoContainer"
        app:layout_constraintEnd_toEndOf="@id/videoContainer"
        app:layout_constraintStart_toStartOf="@id/videoContainer"
        app:layout_constraintTop_toTopOf="@id/videoContainer" />

    <!-- RTSP Stream Loading Indicator -->
    <ProgressBar
        android:id="@+id/pbLoadingImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="3dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/videoContainer"
        app:layout_constraintEnd_toEndOf="@id/videoContainer"
        app:layout_constraintStart_toStartOf="@id/videoContainer"
        app:layout_constraintTop_toTopOf="@id/videoContainer" />

    <LinearLayout
        android:id="@+id/bottomControls"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:background="@drawable/border_bottom_rounded"
        android:descendantFocusability="afterDescendants"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/videoContainer">

        <ImageButton
            android:id="@+id/btnSnapshot"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/bg_btn_remote_selector"
            android:clickable="true"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_camera" />

        <ImageButton
            android:id="@+id/btnRecordVideo"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/bg_btn_remote_selector"
            android:clickable="true"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_video" />

        <ImageButton
            android:id="@+id/btnEnterLandscape"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/bg_btn_remote_selector"
            android:clickable="true"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_fullscreen" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvThumbs"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:descendantFocusability="afterDescendants"
        android:paddingHorizontal="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/btnSimpanCase"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bottomControls" />

    <LinearLayout
        android:id="@+id/recordHud"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_margin="12dp"
        android:background="@drawable/bg_record_hud"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/videoContainer"
        app:layout_constraintTop_toTopOf="@id/videoContainer">

        <TextView
            android:id="@+id/tvRecordTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00:00"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvEmptyThumbs"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/manrope_medium"
        android:padding="8dp"
        android:text="Belum ada media"
        android:textAlignment="center"
        android:textColor="#555555"
        android:textSize="18sp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bottomControls"
        app:layout_constraintVertical_bias="0.3" />

    <ImageView
        android:id="@+id/tvImgNoMedia"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/ic_ooui_image_gallery"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@id/tvEmptyThumbs"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvImgSubtitleNoMedia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/manrope_medium"
        android:text="Media yang Anda ambil akan tampil di sini"
        android:textColor="#999999"
        android:textSize="12sp"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvEmptyThumbs" />

    <Button
        android:id="@+id/btnSimpanCase"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_margin="24dp"
        android:text="Simpan"
        android:textColor="@color/colorWhite"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvMedia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="Media Terekam"
        android:textColor="@color/colorBlack"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bottomControls" />

    <TextView
        android:id="@+id/tvMediaTgl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="17/06/2025"
        android:textColor="#666666"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvMedia" />

    <Button
        android:id="@+id/bnStartStopImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:saveEnabled="false"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvStatusImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvStatistics2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/imageButton3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        tools:ignore="MissingConstraints" />

</androidx.constraintlayout.widget.ConstraintLayout>